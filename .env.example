OPENAI_API_KEY=
# Extraction and transcription go to Groq when this is set, with OpenAI as the fallback.
# Groq's Whisper has no speaker labels, so the transcript comes back as one speaker.
GROQ_API_KEY=
# More Groq keys, comma or newline separated. Tried in order after GROQ_API_KEY before falling back to OpenAI.
GROQ_API_KEYS=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Sample audio script only. Unset keeps text to speech on OpenAI.
# GROQ_TTS_MODEL=
# GROQ_TTS_VOICE=troy
# OPENAI_MODEL=gpt-5.4-mini
# RATE_LIMIT_TRANSCRIBE=3
# RATE_LIMIT_EXTRACT=5
# RATE_LIMIT_WINDOW_MS=3600000
# DAILY_AUDIO_MINUTES=120
# Shared rate limit store (Upstash Redis). Without these, counts stay in memory.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
